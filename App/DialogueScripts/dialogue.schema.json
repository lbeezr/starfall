{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Starfall local dialogue catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scripts"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "scripts": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "lines"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "lines": {
            "type": "array", "minItems": 1, "maxItems": 32,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "speaker", "text", "priority"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "speaker": {"enum": ["sunny", "spark", "pip", "twinkle", "nova", "dusk"]},
                "text": {"type": "string", "minLength": 1, "maxLength": 400},
                "priority": {"enum": ["routine", "help", "warning", "outcome"]},
                "seconds": {"type": "number", "minimum": 4, "maximum": 30}
              }
            }
          }
        }
      }
    }
  }
}
