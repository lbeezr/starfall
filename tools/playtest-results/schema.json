{
  "schema_version": 1,
  "description": "One anonymous participant/session per row. Empty measurement cells mean missing, never failure. Human and synthetic evidence are summarized separately. No names, contact details or free-text notes are accepted.",
  "fields": [
    {"name": "participant_id", "type": "anonymous_id", "description": "Unique P1..P999; a blank template slot is not an observed person."},
    {"name": "evidence_kind", "values": ["human", "synthetic"]},
    {"name": "session_state", "values": ["not_started", "observed"]},
    {"name": "first_time", "values": ["yes", "no", "not_observed"]},
    {"name": "session_date", "type": "date"},
    {"name": "build_source_sha", "type": "git_sha"},
    {"name": "comprehension_3plus", "values": ["unaided", "assisted", "not_understood", "not_observed"]},
    {"name": "comprehension_orthogonal", "values": ["unaided", "assisted", "not_understood", "not_observed"]},
    {"name": "comprehension_goal", "values": ["unaided", "assisted", "not_understood", "not_observed"]},
    {"name": "comprehension_moves", "values": ["unaided", "assisted", "not_understood", "not_observed"]},
    {"name": "choice_options", "values": ["multiple", "forced", "not_observed"]},
    {"name": "choice_reason", "values": ["current_size", "correct_survivors", "other", "not_observed"]},
    {"name": "recovery_seen", "values": ["yes", "no", "not_observed"]},
    {"name": "recovery_understanding", "values": ["understood", "not_understood", "not_observed"]},
    {"name": "round_status", "values": ["unfinished", "won", "lost", "not_observed"]},
    {"name": "score_at_stop", "type": "integer", "minimum": 0, "maximum": 118},
    {"name": "moves_at_stop", "type": "integer", "minimum": 0, "maximum": 18},
    {"name": "replay_time", "values": ["available", "unavailable", "not_observed"]},
    {"name": "replay_action", "values": ["new_round", "continue", "stop", "not_observed"]},
    {"name": "replay_start_independent", "values": ["yes", "no", "not_observed"]},
    {"name": "stated_replay_interest", "values": ["yes", "no", "unsure", "not_asked"]},
    {"name": "planning_a", "values": ["pass", "fail", "not_observed", "unavailable"]},
    {"name": "a_extra_help", "values": ["yes", "no", "not_observed"]},
    {"name": "planning_b", "values": ["pass", "fail", "not_observed", "unavailable"]},
    {"name": "gravity_explanation", "values": ["accepted", "declined", "not_offered", "not_observed"]},
    {"name": "b_extra_help", "values": ["yes", "no", "not_observed"]},
    {"name": "r1_recognition", "values": ["observed", "not_yet", "not_observed", "unavailable"]},
    {"name": "r1_prior_ab", "values": ["yes", "no", "not_observed"]},
    {"name": "r1_prior_explanation", "values": ["yes", "no", "not_observed"]},
    {"name": "r1_extra_prompt", "values": ["yes", "no", "not_observed"]},
    {"name": "satisfaction", "type": "integer", "minimum": 1, "maximum": 5},
    {"name": "control", "type": "integer", "minimum": 1, "maximum": 5},
    {"name": "calmness", "type": "integer", "minimum": 1, "maximum": 5}
  ]
}
